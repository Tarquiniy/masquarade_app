// Copy this file to lib/env.dart and fill in your actual values.
// NEVER commit lib/env.dart to version control.

// Supabase — anon key (safe for client, RLS enforced)
const String supabase_url = 'https://<project-ref>.supabase.co';
const String supabase_anonKey = '<supabase-anon-key>';

// Supabase — service-role key (used in MediaService for storage uploads)
// WARNING: treat as a secret; not exposed to end users via RLS bypass
const String supabase_serviceKey = '<supabase-service-role-key>';

// Firebase Web config (public, safe to commit — Firebase security rules enforce access)
const String firebase_apiKey = '<firebase-api-key>';
const String firebase_authDomain = '<project>.firebaseapp.com';
const String firebase_projectId = '<project>';
const String firebase_storageBucket = '<project>.firebasestorage.app';
const String firebase_messagingSenderId = '<sender-id>';
const String firebase_appId = '<app-id>';

// Telegram notification bot token (used in domain_bloc for direct notifications)
// In production, prefer routing through the Supabase Edge Function instead.
const String telegramNotificationBotToken = '<telegram-bot-token>';
