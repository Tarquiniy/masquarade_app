// This file documents what lib/env.dart provides.
// lib/env.dart is committed to the repo with public values already filled in.
// Secrets (SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY, TELEGRAM_NOTIFICATION_BOT_TOKEN)
// are injected at build time via --dart-define and never stored in source code.
//
// Local development — pass dart-define flags to flutter run:
//   flutter run \
//     --dart-define=SUPABASE_ANON_KEY=eyJ... \
//     --dart-define=SUPABASE_SERVICE_KEY=eyJ... \
//     --dart-define=TELEGRAM_NOTIFICATION_BOT_TOKEN=123:ABC...
//
// CI — store values as GitHub Actions Secrets:
//   SUPABASE_ANON_KEY
//   SUPABASE_SERVICE_KEY
//   TELEGRAM_NOTIFICATION_BOT_TOKEN
//   FIREBASE_SERVICE_ACCOUNT_TANKOGRAD  (for Firebase Hosting deploy)
