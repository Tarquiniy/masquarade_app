# Telegram Bot (bot.py — notification bot using python-telegram-bot)
TELEGRAM_BOT_TOKEN=

# Telegram Bot (telegram_bot_psycopg2.py — login-code bot using aiogram)
# TELEGRAM_BOT_TOKEN= (same variable, use separate .env per bot if running both)

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-service-role-key>

# PostgreSQL DSN (for telegram_bot_psycopg2.py direct DB access)
PG_DSN=dbname='postgres' user='postgres.<project-ref>' password='<password>' host='aws-0-<region>.pooler.supabase.com' port='6543'
