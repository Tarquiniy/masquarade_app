# =============================================================================
# Python Telegram Bots
# =============================================================================

# bot.py — notification bot (python-telegram-bot)
TELEGRAM_BOT_TOKEN=

# Supabase (used by bot.py)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-service-role-key>

# telegram_bot_psycopg2.py — login-code bot (aiogram + psycopg2)
# Uses the same TELEGRAM_BOT_TOKEN above (separate .env per bot if running both)
PG_DSN=dbname='postgres' user='postgres.<project-ref>' password='<password>' host='aws-0-<region>.pooler.supabase.com' port='6543'

# =============================================================================
# Flutter App
# =============================================================================
# Flutter reads credentials from lib/env.dart (not from .env).
# Copy lib/env.dart.example to lib/env.dart and fill in the values.
# lib/env.dart is excluded from version control via .gitignore.

# =============================================================================
# Supabase Edge Functions
# =============================================================================
# Set these as Supabase secrets (supabase secrets set KEY=value):
#   TELEGRAM_NOTIFICATION_BOT_TOKEN
#   TELEGRAM_DEBUG_BOT_TOKEN
#   TELEGRAM_DEBUG_CHAT_ID
